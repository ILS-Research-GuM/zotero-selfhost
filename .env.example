# Example configuration. Easiest: utils/setup-env.sh <host> creates .env with random secrets.
# Or copy this file to .env and replace every "change-me" value.
# The URLs below show a setup behind a TLS reverse proxy with one host name per service
# (see README.md); without a proxy use e.g. http://<host>:8180 etc.

# Host address and ports the services listen on.
# 127.0.0.1 = only reachable locally (e.g. behind a reverse proxy); 0.0.0.0 = all interfaces
BIND_ADDRESS=127.0.0.1
API_PORT=8180
STREAM_PORT=8181
S3_PORT=8182
WEB_LIBRARY_PORT=8183
PORTAL_PORT=8184

# URLs as reachable by clients
ZOTERO_API_URL=https://api.zotero.example.org
S3_PUBLIC_URL=https://s3.zotero.example.org
STREAMING_URL=wss://stream.zotero.example.org/
WEB_LIBRARY_URL=https://zotero.example.org
API_SCHEME=https
API_AUTHORITY=api.zotero.example.org

# Secrets
MYSQL_ROOT_PASSWORD=change-me
# 32 hex digits
ZOTERO_AUTH_SALT=change-me
ZOTERO_SUPER_USER=admin
ZOTERO_SUPER_PASSWORD=change-me
# Garage requires key IDs of the form GK + 24 hex digits and 64 hex digit secrets
S3_ACCESS_KEY=GK000000000000000000000000
S3_SECRET_KEY=change-me
# 64 hex digits
GARAGE_RPC_SECRET=change-me

# First user, created by bin/init.sh
ZOTERO_ADMIN_USER=admin
ZOTERO_ADMIN_PASSWORD=change-me
ZOTERO_ADMIN_EMAIL=admin@localhost
# Storage quota per new user in MB (1000000 = unlimited)
ZOTERO_STORAGE_QUOTA_MB=1000000
# Shared group every user joins, set up once if SHARED_GROUP_OWNER is set: named
# DEFAULT_GROUP_NAME, read-only for members, owned by the user with that email (more writers:
# bin/set-group-role.sh). Empty: no shared group.
DEFAULT_GROUP_NAME=Shared
SHARED_GROUP_OWNER=

# Login for the web-library and the desktop client (portal service). With OIDC_ISSUER empty,
# users log in with username and password (bin/create-user.sh).
# Example: https://id.example.org/realms/example (redirect URI: <WEB_LIBRARY_URL>/oidc/callback)
OIDC_ISSUER=
OIDC_CLIENT_ID=zotero
OIDC_CLIENT_SECRET=
# Button text for the OIDC login on the sign-in page
OIDC_LABEL=
# true: password login next to OIDC, e.g. for external users created with bin/create-user.sh.
# Empty: only without OIDC.
PASSWORD_LOGIN=
# Default language of the portal pages: en or de. Users can switch on each page.
# Empty: the browser's language (default English)
PORTAL_LANGUAGE=
# Owner (uid:gid) of data/downloads, the public downloads of the portal (/downloads).
# Set it to the host user that publishes files there, e.g. 1000:1000. Default: root.
DOWNLOADS_OWNER=

# Commit of src/server/web-library (see versions.lock), updated by utils/update.sh
WEB_LIBRARY_COMMIT=9f6cf7923fbab6f55da46586793ab0a2f9a2dc84
